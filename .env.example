# Copy this file to .env for local development.
# Never commit .env or expose database credentials in browser code.

# -----------------------------------------------------------------------------
# Public/frontend configuration
# -----------------------------------------------------------------------------
# This is safe to use in the browser because it contains no secret.
# Example: https://api.example.com or /api
VITE_API_BASE_URL="http://localhost:4000/api"
VITE_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Backend-only configuration
# -----------------------------------------------------------------------------
# These values must only be read by your Node/Express backend. Do not prefix
# them with VITE_ or they may be bundled into the public JavaScript.
NODE_ENV="development"
PORT="4000"
API_PORT="4000"

# SQL connection: use one of the two formats below.
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DB_CLIENT="mysql"
DB_HOST="srv2229.hstgr.io"
DB_PORT="3306"
DB_NAME="u655027224_rstechwerk"
DB_USER="u655027224_rstechwerk"
DB_PASSWORD="your-hostinger-mysql-password"
DB_SSL="false"

# Authentication/session secrets. Generate long random values for production.
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET="replace-with-another-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-admin-password"

# CORS: comma-separated public origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,https://rstechwerk.com"

# Optional transactional email/webhook settings.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
INQUIRY_NOTIFY_EMAIL="inquiry@rstechwerk.com"
WEBHOOK_INQUIRY_URL=""

# Optional AI integration. Keep this backend-only.
GEMINI_API_KEY=""

# Canonical/public application URL used by backend links and callbacks.
APP_URL="http://localhost:3000"

# Payment providers (backend-only; use sandbox/test credentials locally)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="replace-with-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="replace-with-paypal-sandbox-client-secret"
